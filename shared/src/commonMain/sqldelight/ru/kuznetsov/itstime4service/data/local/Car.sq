CREATE TABLE cars (
    id TEXT NOT NULL PRIMARY KEY,
    brand TEXT NOT NULL,
    mileage_km INTEGER NOT NULL,
    vin TEXT,
    is_sold INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0
);

selectAll:
SELECT * FROM cars WHERE is_sold = 0 ORDER BY rowid;

selectById:
SELECT * FROM cars WHERE id = ? AND is_sold = 0;

selectAllWithSold:
SELECT * FROM cars ORDER BY is_sold, rowid;

insert:
INSERT INTO cars (id, brand, mileage_km, vin) VALUES (?, ?, ?, ?);

updateMileage:
UPDATE cars SET mileage_km = ? WHERE id = ?;

updateDetails:
UPDATE cars SET brand = ?, vin = ? WHERE id = ?;

markSold:
UPDATE cars SET is_sold = 1 WHERE id = ?;

deleteById:
DELETE FROM cars WHERE id = ?;
