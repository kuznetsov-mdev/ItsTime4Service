CREATE TABLE settings (
    id INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),
    theme_mode TEXT NOT NULL,
    distance_unit TEXT NOT NULL,
    push_enabled INTEGER AS kotlin.Boolean NOT NULL,
    default_reminder_window_km INTEGER NOT NULL,
    reminder_time TEXT NOT NULL
);

select:
SELECT * FROM settings WHERE id = 1;

upsert:
INSERT OR REPLACE INTO settings (id, theme_mode, distance_unit, push_enabled, default_reminder_window_km, reminder_time)
VALUES (1, ?, ?, ?, ?, ?);
